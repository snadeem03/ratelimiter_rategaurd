# RateGuard example configuration.
#
# Copy this file to `.env` (gitignored) and adjust for local development, or
# export the variables directly. NEVER commit real credentials or tokens.
#
# When running with Docker Compose, the app config is supplied by
# docker-compose.yml (RATE_LIMIT_BACKEND=redis, REDIS_URL=redis://redis:6379/0);
# override values by exporting the same variables before `docker compose up`.

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_ALGORITHM=sliding_window   # fixed_window | sliding_window | token_bucket | leaky_bucket
RATE_LIMIT=5
RATE_LIMIT_WINDOW=60
# Optional per-route overrides, e.g. /api/login:10:60,/api/products:200:60
RATE_LIMIT_ROUTES=

# --- Backend -------------------------------------------------------------
# memory (per-process) | redis (shared across uvicorn workers)
RATE_LIMIT_BACKEND=memory
# Local Redis (not used in Docker Compose, where REDIS_URL=redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
# REDIS_SOCKET_TIMEOUT=2
# REDIS_SOCKET_CONNECT_TIMEOUT=2
# REDIS_HEALTH_CHECK_INTERVAL=30

# --- Admin API -----------------------------------------------------------
# Set a strong random value to enable /admin/api-keys. If unset, the admin
# API returns 403. Never commit the real value.
ADMIN_API_TOKEN=

# --- Security / API keys -------------------------------------------------
TRUST_PROXY_HEADERS=false            # set true only behind a trusted reverse proxy
API_KEY_PREFIX=rg_live_
API_KEY_STORE_PATH=api_keys.json     # only used with RATE_LIMIT_BACKEND=memory